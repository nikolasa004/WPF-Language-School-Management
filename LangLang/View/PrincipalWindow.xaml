<Window x:Class="LangLang.RoleWindows.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:LangLang.Converters"
        xmlns:local="clr-namespace:LangLang.Model.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="PrincipalWindow" 
        Height="600" Width="900"
        Icon="/GUIResources/icon.ico">

    <Window.Resources>
        <conv:DateToStringConverter x:Key="DateToStringConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>

        <ControlTemplate x:Key="ValidationTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="textBox" />
                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red" FontFamily="Script MT Bold" HorizontalAlignment="Right" Background="#80000000"/>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <!-- Main panel -->
        <Grid x:Name="MainPanel" Visibility="Visible">
            <Viewbox Stretch="Uniform">
                <Grid Width="800" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Top bar -->
                        <RowDefinition Height="*"/>
                        <!-- Filters -->
                        <RowDefinition Height="Auto"/>
                        <!-- Content -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom buttons -->
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Grid Grid.Row="0" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Navigation buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">

                            <!-- Professors Button -->
                            <Button x:Name="ProfessorsButton" Content="Professors" Style="{StaticResource FancyButtonStyle}" FontSize="20" Width="100" Height="35" Click="ProfessorsButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>

                            </Button>

                            <!-- Courses Button -->
                            <Button x:Name="CoursesButton" Content="Courses" Style="{StaticResource FancyButtonStyle}" FontSize="20" Width="100" Height="40" Click="DropDown_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                                
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="CoursesContextMenu" Placement="Bottom">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>

                                        <MenuItem Header="Show available courses" Tag="ShowAllCourses_Click" Click="TeachingActivity_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="Finished courses" Click="CoursesButton_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Exams Button -->
                            <Button x:Name="ExamsButton" Content="Exams" Style="{StaticResource FancyButtonStyle}" FontSize="20" Width="100" Height="35" Click="ExamsButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                            </Button>

                            <!-- Reports Button -->
                            <Button x:Name="ReportsButton" Content="Reports" Style="{StaticResource FancyButtonStyle}" FontSize="20" Width="100" Height="35" Click="DropDown_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>

                                <Button.ContextMenu>
                                    <ContextMenu x:Name="ReportsContextMenu" Placement="Bottom">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>

                                        <MenuItem Header="Generate penalty report" Tag="penalty" Click="Reports_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="Generate average grades report" Tag="average" Click="Reports_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>

                                        <MenuItem Header="Sledeci izvestaj neki" Click="Reports_Click">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>

                        <!-- Inbox button on the right -->
                        <Button Content="" Style="{StaticResource FancyButtonStyle}" Width="40" Height="40" HorizontalAlignment="Right" Grid.Column="1">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/inbox.png"/>
                            </Button.Background>
                        </Button>
                    </Grid>
                    
                    <!-- ====== Filters ====== -->
                    <WrapPanel Grid.Row="1" Background="#66000000" ItemHeight="35">
                        <Label Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ExamLanguageCombo"
                              Width="170" Height="35"
                              Margin="6,6,12,6"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding AvailableLanguages}"
                              SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"/>


                        <Label Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="ExamLevelCombo"
                            Width="170" Height="35"
                            Margin="6,6,12,6"
                            VerticalAlignment="Center"
                            ItemsSource="{Binding AvailableLevels}"
                            SelectedItem="{Binding SelectedLevel, Mode=TwoWay}"/>

                        <Label Content="From:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                        <DatePicker x:Name="ExamFromDate"
                            Width="160" Height="35"
                            Margin="6,6,12,6"
                            VerticalAlignment="Center"/>

                        <Label Content="To:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                        <DatePicker x:Name="ExamToDate"
                            Width="160" Height="35"
                            Margin="6,6,12,6"
                            VerticalAlignment="Center"/>

                        <Button Content="Search"
                            Style="{StaticResource FancyButtonStyle}"
                            FontSize="16"
                            Width="120" Height="35"
                            Margin="12,6,0,6"
                            VerticalAlignment="Center"
                            Click="Search_Click"
    >
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>

                        <Button Content="Remove Filters"
                            Style="{StaticResource FancyButtonStyle}"
                            FontSize="16"
                            Width="140" Height="35"
                            Margin="12,6,0,6"
                            VerticalAlignment="Center"
                            Click="RemoveFilters_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </WrapPanel>

                    <!-- Content: DataGrid for teachers -->
                    <Grid Grid.Row="2" Margin="0,20,0,0" Background="#80000000">
                        <DataGrid x:Name="ProfessorsDataGrid" 
                            AutoGenerateColumns="False" 
                            FontSize="14" 
                            Foreground="White" 
                            Background="#66000000"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            RowBackground="#33000000"
                            AlternatingRowBackground="#22000000"
                            BorderBrush="#00000000"
                            FontFamily="Script MT Bold"
                            IsReadOnly="True">

                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="#88000000"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                </Style>
                                <Style TargetType="{x:Type DataGridCell}">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                                    <Setter Property="BorderBrush" Value="#00000000"/>
                                    <Setter Property="Padding" Value="6,2"/>
                                    
                                </Style>

                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                                <DataGridTextColumn Header="Date Added" Binding="{Binding DateOfRegistration}" Width="*"/>
                                <DataGridTemplateColumn Header="Actions" Width="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <Button Content="Edit" Style="{StaticResource FancyButtonStyle}" Width="70" Height="30" Margin="2,0" Click="UpdateProfessor_Click">
                                                    <Button.Background>
                                                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                                    </Button.Background>
                                                </Button>
                                                <Button Content="Delete" Style="{StaticResource FancyButtonStyle}" Width="70" Height="30" Margin="6,0,0,0" Click="DeleteProfessor_Click">
                                                    <Button.Background>
                                                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                                    </Button.Background>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Bottom buttons -->
                    <WrapPanel Grid.Row="3" HorizontalAlignment="Center"  Margin="0,20,0,0">
                        <Button Content="Add Professor" Style="{StaticResource FancyButtonStyle}" Width="120" Height="38" Margin="6,0" FontSize="16" Click="AddProfessor_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </WrapPanel>
                </Grid>
            </Viewbox>
        </Grid>
        
        <!-- Add/Edit Professor Overlay -->
        <Grid x:Name="AddEditProfessorOverlay" Visibility="Collapsed" Background="#80000000" Panel.ZIndex="999">
            <Grid.Resources>
                <Style x:Key="GoldComboItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD24D"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0B000"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="GoldComboStyle" TargetType="{x:Type ComboBox}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource GoldComboItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBox}">
                                <Grid SnapsToDevicePixels="True">
                                    <Border Background="Gold"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4">
                                        <DockPanel>
                                            <ToggleButton x:Name="PART_DropDownToggle"
                                              DockPanel.Dock="Right"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Background="Gold"
                                              BorderThickness="0"
                                              Width="28">               
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z"
                                                  Fill="White"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>
                                            <ContentPresenter Margin="6,0,6,0"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </Border>

                                    <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                       <Border Background="Gold"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="2"
                                            CornerRadius="4"
                                            Margin="0,2,0,0">
                                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                       </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="GoldTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="GoldDatePickerStyle" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <Border CornerRadius="10" Padding="18" Width="600" Height="400"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Scrollable Content -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,0,10">
                        <Grid Width="400" Margin="10,10,10,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- First Name -->
                            <Label Content="First Name:" FontSize="16" Foreground="White" Grid.Row="0" Grid.Column="0" FontFamily="Script MT Bold" />
                            <TextBox x:Name="FirstNameBox" Height="30" FontSize="14" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" VerticalContentAlignment="Center" Text="{Binding Path=Professor.FirstName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                            <!-- Last Name -->
                            <Label Content="Last Name:" FontSize="16" Foreground="White" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" FontFamily="Script MT Bold"/>
                            <TextBox x:Name="LastNameBox" Height="30" FontSize="14" Grid.Row="1" Grid.Column="1" Margin="10,0,0,10" VerticalContentAlignment="Center" Text="{Binding Path=Professor.LastName, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                            <!-- Gender -->
                            <Label Content="Gender:" FontSize="16" Foreground="White" Grid.Row="2" Grid.Column="0" FontFamily="Script MT Bold"/>
                            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0,0,0,10">
                                <RadioButton Content="Male" FontFamily="Script MT Bold" IsChecked="{Binding Path=Professor.Gender, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Male, Mode=TwoWay}" />
                                <RadioButton Content="Female" FontFamily="Script MT Bold" IsChecked="{Binding Path=Professor.Gender, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Female, Mode=TwoWay}" />
                            </StackPanel>

                            <!-- Birth Date -->
                            <Label Content="Birth Date:" FontSize="16" Foreground="White" Grid.Row="2" Grid.Column="1" Margin="10,0,0,0" FontFamily="Script MT Bold"/>
                            <DatePicker x:Name="BirthDatePicker" Language="sr-RS" Height="30" FontSize="14" Grid.Row="3" Grid.Column="1" Margin="10,0,0,10" VerticalContentAlignment="Center" SelectedDate="{Binding Path=Professor.DateOfBirth, Converter={StaticResource DateToStringConverter}, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                            <!-- Phone Number -->
                            <Label Content="Phone Number:" FontSize="16" Foreground="White" Grid.Row="4" Grid.Column="0" FontFamily="Script MT Bold"/>
                            <TextBox x:Name="PhoneBox" Height="30" FontSize="14" Grid.Row="5" Grid.Column="0" Margin="0,0,10,10" VerticalContentAlignment="Center" Text="{Binding Path=Professor.PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                            <!-- Email -->
                            <Label Content="Email:" FontSize="16" Foreground="White" Grid.Row="4" Grid.Column="1" Margin="10,0,0,0" FontFamily="Script MT Bold"/>
                            <TextBox x:Name="EmailBoxRegister" Height="30" FontSize="14" Grid.Row="5" Grid.Column="1" Margin="10,0,0,10" VerticalContentAlignment="Center" Text="{Binding Path=Professor.Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                            <!-- Password -->
                            <Label Content="Password:" FontSize="16" Foreground="White" Grid.Row="6" Grid.Column="0" FontFamily="Script MT Bold"/>
                            <TextBox x:Name="PasswordBoxRegister" Height="30" FontSize="14" Grid.Row="7" Grid.Column="0" Margin="0,0,10,15" VerticalContentAlignment="Center" Text="{Binding Path=Professor.Password, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                            <!-- Language Selection Section (All language-related elements grouped here) -->
                            <StackPanel x:Name="LanguagesSection" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,10,0,0">
                                <!-- Language Selection Title-->
                                <Label Content="Language Selection:" FontSize="16" Foreground="White" FontFamily="Script MT Bold" Margin="0,0,0,5"/>

                                <!-- Language Selection Input Grid -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Language ComboBox -->
                                    <Label Content="Language:" FontSize="14" Foreground="White" Grid.Row="0" Grid.Column="0" FontFamily="Script MT Bold"/>
                                    <ComboBox x:Name="LanguageComboBox" Height="30" FontSize="14" Grid.Row="1" Grid.Column="0" Margin="0,0,10,10" 
                                              ItemsSource="{Binding AvailableLanguages}" Style="{StaticResource GoldComboStyle}"/>

                                    <!-- Language Level ComboBox -->
                                    <Label Content="Level:" FontSize="14" Foreground="White" Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" FontFamily="Script MT Bold"/>
                                    <ComboBox x:Name="LanguageLevelComboBox" Height="30" FontSize="14" Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"
                                              ItemsSource="{Binding AvailableLevels}" Style="{StaticResource GoldComboStyle}"/>

                                    <!-- Add Language Button -->
                                    <Button Content="Add Language" Width="120" Height="30" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Click="AddLanguage_Click" 
                                            Style="{StaticResource FancyButtonStyle}">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                </Grid>

                                <!-- Selected Languages List -->
                                <Label Content="Selected Languages:" FontSize="14" Foreground="White" FontFamily="Script MT Bold" Margin="0,0,0,5"/>
                                <ScrollViewer Height="150" Margin="0,0,0,20" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ProfessorLanguagesDisplay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="Gold" BorderBrush="#B8860B" BorderThickness="1" CornerRadius="3" Margin="0,2" Padding="8,4">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding}" Foreground="White" FontFamily="Script MT Bold" FontSize="14" VerticalAlignment="Center"/>
                                                        <Button Grid.Column="1" Content="Remove" Width="60" Height="20" FontFamily="Script MT Bold" FontSize="10" 
                                        Click="RemoveLanguage_Click" Tag="{Binding}"
                                        Background="Red" Foreground="White" BorderThickness="0">
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Buttons at Bottom -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                        <Button Content="Save" Width="100" Height="38" Margin="8"
                            Click="SaveProfessor_Click"
                            Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="100" Height="38" Margin="8"
                            Click="CancelProfessor_Click"
                            Style="{StaticResource FancyButtonStyle}">
                             <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================== EXAM OVERLAY ================== -->
        <Grid x:Name="PrincipalExamOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <Border CornerRadius="10" Padding="18" Width="800" MinHeight="500"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Past Exam Terms"
                   Foreground="Gold"
                   FontSize="22"
                   FontFamily="Script MT Bold"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,8"/>

                    <!-- Exams DataGrid -->
                    <DataGrid Grid.Row="1"
                    x:Name="ExamTermsGrid"
                    ItemsSource="{Binding ExamTermsObservable}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    VerticalAlignment="Stretch"
                    Background="#66000000"
                    Foreground="White"
                    FontFamily="Script MT Bold"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    RowBackground="#33000000"
                    AlternatingRowBackground="#22000000"
                    BorderBrush="#00000000">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DGCellStyle}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="*" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="*" />
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="120"/>
                            <DataGridTextColumn Header="Start At" Binding="{Binding StartAt}" Width="120"/>
                            <DataGridTextColumn Header="Duration (min)" Binding="{Binding Duration}" Width="120"/>
                            <DataGridTextColumn Header="Room" Binding="{Binding RoomId}" Width="*" />
                            <DataGridTextColumn Header="Max Attendees" Binding="{Binding MaxAttendees}" Width="120"/>

                            <!-- Confirm Results Button -->
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Confirm Results" 
                                        Width="140" Height="28"
                                        Click="ConfirmResults_Click"
                                        Style="{StaticResource FancyButtonStyle}">
                                            <Button.Background>
                                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                            </Button.Background>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Close" Width="140" Height="38" Margin="8"
                        Click="ClosePrincipalExam_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================== /EXAM OVERLAY ================== -->

        <!-- ================== COURSE OVERLAY ================== -->
        <Grid x:Name="PrincipalCourseOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <Border CornerRadius="10" Padding="18" Width="800" MinHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title + Radio buttons -->
                    <Grid Grid.Row="0" Margin="0,20,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Title -->
                        <Label Content="Past Courses"
                           Foreground="Gold"
                           FontSize="22"
                           FontFamily="Script MT Bold"
                           HorizontalAlignment="Center"
                           Grid.Column="0"/>

                        <!-- Radio Buttons -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                            <RadioButton x:Name="KnowledgeRadio"
                             Content="Knowledge"
                             FontFamily="Script MT Bold"
                             Foreground="White"
                             FontSize="16"
                             GroupName="ComplimentType"
                             Margin="0,0,10,0"
                             IsChecked="True"/>
                            <RadioButton x:Name="ActivityRadio"
                     Content="Activity"
                     FontFamily="Script MT Bold"
                     Foreground="White"
                     FontSize="16"
                     GroupName="ComplimentType"/>
                        </StackPanel>
                    </Grid>

                    <!-- Courses DataGrid -->
                    <DataGrid Grid.Row="1"
                    x:Name="CoursesGrid"
                    ItemsSource="{Binding CoursesObservable}"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserDeleteRows="False"
                    IsReadOnly="True"
                    CanUserSortColumns="True"
                    VerticalAlignment="Stretch"
                    Background="#66000000"
                    Foreground="White"
                    FontFamily="Script MT Bold"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    RowBackground="#33000000"
                    AlternatingRowBackground="#22000000"
                    BorderBrush="#00000000">

                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                            <Style TargetType="DataGridCell" BasedOn="{StaticResource DGCellStyle}"/>
                        </DataGrid.Resources>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="40" /> 
                            <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="*" />
                            <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="60" />
                            <DataGridTextColumn Header="Start Date" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="Duration" Binding="{Binding DurationWeeks}" Width="60"/>
                            <DataGridTextColumn Header="Professor" Binding="{Binding ProfessorId}" Width="*" />

                            <!-- Confirm Results Button -->
                            <DataGridTemplateColumn Header="Actions" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Send compliments" 
                                        Width="140" Height="28"
                                        Click="SendCompliments_Click"
                                        Style="{StaticResource FancyButtonStyle}">
                                            <Button.Background>
                                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                            </Button.Background>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
        HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Close" Width="140" Height="38" Margin="8"
                Click="ClosePrincipalCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ===================================================================== -->
        <!-- ==================  (1) PRINCIPAL COURSES PANEL  ==================== -->
        <!-- ===================================================================== -->
        <Grid x:Name="PrincipalCoursesPanel" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Lokalni stilovi za ovaj panel -->
            <Grid.Resources>
                <Style x:Key="PrincipalGoldComboItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD24D"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0B000"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="PrincipalGoldComboStyle" TargetType="ComboBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource PrincipalGoldComboItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid SnapsToDevicePixels="True">
                                    <Border Background="Gold"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="4">
                                        <DockPanel>
                                            <ToggleButton x:Name="PART_DropDownToggle"
                                                          DockPanel.Dock="Right"
                                                          Focusable="False"
                                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                          ClickMode="Press"
                                                          Background="Gold"
                                                          BorderThickness="0"
                                                          Width="28">
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>
                                            <ContentPresenter Margin="6,0,6,0"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </Border>
                                    <Popup x:Name="PART_Popup"
                                           Placement="Bottom"
                                           IsOpen="{TemplateBinding IsDropDownOpen}"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           PopupAnimation="Slide">
                                        <Border Background="Gold" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="4" Margin="0,2,0,0">
                                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="PrincipalGoldDatePickerStyle" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="PrincipalGoldTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <!-- FILTERI -->
            <WrapPanel Grid.Row="0" Background="#66000000" ItemHeight="35">
                <Label Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="PrincipalCourseLanguageCombo" Style="{StaticResource PrincipalGoldComboStyle}"
                          Width="170" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="PrincipalCourseLevelCombo" Style="{StaticResource PrincipalGoldComboStyle}"
                          Width="170" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="Live:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="PrincipalCourseOnlineCombo" Style="{StaticResource PrincipalGoldComboStyle}"
                          Width="75" Height="35" Margin="6,6,12,6" VerticalAlignment="Center">
                    <ComboBoxItem Content="Yes"/>
                    <ComboBoxItem Content="No"/>
                </ComboBox>

                <Label Content="Weeks:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="PrincipalCourseWeeksBox" Style="{StaticResource PrincipalGoldTextBoxStyle}"
                         Width="50" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="From:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="PrincipalCourseFromDate" Style="{StaticResource PrincipalGoldDatePickerStyle}"
                            Width="160" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="To:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="PrincipalCourseToDate" Style="{StaticResource PrincipalGoldDatePickerStyle}"
                            Width="160" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Button x:Name="PrincipalCoursesSearchButton" Content="Search" Style="{StaticResource FancyButtonStyle}"
                        FontSize="16" Width="120" Height="35" Margin="12,6,0,6" VerticalAlignment="Center"
                        Click="CoursesSearch_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>
            </WrapPanel>

            <!-- TABELA KURSEVA -->
            <DataGrid x:Name="PrincipalBrowseCoursesGrid"
                      Grid.Row="1" Margin="0,8,0,8"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserSortColumns="True" Sorting="CoursesGrid_Sorting"
                      Background="#66000000" Foreground="White" FontFamily="Script MT Bold"
                      GridLinesVisibility="None" HeadersVisibility="Column"
                      RowBackground="#33000000" AlternatingRowBackground="#22000000"
                      BorderBrush="#00000000"
                      CellStyle="{DynamicResource PrincipalCourseCellStyle}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#88000000"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontFamily" Value="Script MT Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Padding" Value="6,4"/>
                    </Style>
                    <Style x:Key="PrincipalCourseCellStyle" TargetType="{x:Type DataGridCell}">
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontFamily" Value="Script MT Bold"/>
                        <Setter Property="BorderBrush" Value="#00000000"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Style.Triggers>
                            <!-- kurs bez profesora (null) -->
                            <DataTrigger Binding="{Binding ProfessorId}" Value="{x:Null}">
                                <Setter Property="Background" Value="#55FF3B30"/>
                                <Setter Property="ToolTip"   Value="No professor assigned"/>
                            </DataTrigger>
                            <!-- kurs bez profesora (prazan string) -->
                            <DataTrigger Binding="{Binding ProfessorId}" Value="">
                                <Setter Property="Background" Value="#55FF3B30"/>
                                <Setter Property="ToolTip"   Value="No professor assigned"/>
                            </DataTrigger>
                            <!-- kada je selektovano, koristi sistemsku boju selekcije -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background"
                            Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    
                    
                    <DataGridTextColumn Header="ID"         Binding="{Binding Id}"            SortMemberPath="Id"            Width="60"/>
                    <DataGridTextColumn Header="Language"   Binding="{Binding Language}"      SortMemberPath="Language"      Width="*"/>
                    <DataGridTextColumn Header="Level"      Binding="{Binding Level}"         SortMemberPath="Level"         Width="*"/>
                    <DataGridTextColumn Header="Start date" Binding="{Binding Date}"          SortMemberPath="Date"          Width="110"/>
                    <DataGridTextColumn Header="Professor"  Binding="{Binding ProfessorId}"   SortMemberPath="ProfessorId"   Width="*"/>
                    <DataGridTextColumn Header="Weeks"      Binding="{Binding DurationWeeks}" SortMemberPath="DurationWeeks" Width="*"/>
                    <DataGridTextColumn Header="Days"       Binding="{Binding DaysFormatted}" SortMemberPath="DaysFormatted" Width="*"/>
                    <DataGridTextColumn Header="Start"      Binding="{Binding StartAt}"       SortMemberPath="StartAt"       Width="*"/>
                    <DataGridTextColumn Header="Live"       Binding="{Binding IsLive}"        SortMemberPath="IsLive"        Width="80"/>
                    <DataGridTextColumn Header="Room"       Binding="{Binding RoomId}"        SortMemberPath="RoomId"        Width="80"/>
                    <DataGridTextColumn Header="Max"        Binding="{Binding MaxAttendees}"  SortMemberPath="MaxAttendees"  Width="80"/>

                    <DataGridTemplateColumn Header="Actions" Width="260">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit" Width="70" Height="30" Margin="2,0"
                                            Style="{StaticResource FancyButtonStyle}"
                                            Click="EditCourse_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button Content="Delete" Width="80" Height="30" Margin="6,0,0,0"
                                            Style="{StaticResource FancyButtonStyle}"
                                            Click="DeleteCourse_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                    
                                    
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
             

            </DataGrid>

            <!-- DNO: back + add + paginacija -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="PrincipalCloseCoursesPanelBtn" Grid.Column="0" Content="Back" Style="{StaticResource FancyButtonStyle}"
                        FontSize="16" Width="120" Height="38" Margin="6,0" Click="CloseCoursesPanel_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>

                <Button x:Name="PrincipalAddCourseButton" Grid.Column="1" Content="Add" Style="{StaticResource FancyButtonStyle}"
                        FontSize="16" Width="120" Height="38" Margin="6,0" Click="AddCourseButton_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>

                <!-- NEW: Assign professor -->
                <Button x:Name="PrincipalAssignProfessorButton" Grid.Column="2" Content="Assign professor"
            Style="{StaticResource FancyButtonStyle}" FontSize="16" Width="160" Height="38" Margin="6,0"
            Click="AssignProfessor_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Per page:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PrincipalPageSizeComboCourses" Width="70" Height="34" Margin="0,0,12,0" SelectionChanged="PageSizeComboCourses_SelectionChanged">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>

                    <Button x:Name="PrincipalPrevPageBtnCourses" Content="◀ Prev" Style="{StaticResource FancyButtonStyle}" Width="90" Height="34" Margin="6,0" Click="PrevPageCourses_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>

                    <TextBlock x:Name="PrincipalPagerTextCourses" Text="Page 1/1 · 0 items" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="8,0"/>

                    <Button x:Name="PrincipalNextPageBtnCourses" Content="Next ▶" Style="{StaticResource FancyButtonStyle}" Width="90" Height="34" Margin="6,0" Click="NextPageCourses_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
        <!-- ================== /PRINCIPAL COURSES PANEL ================== -->


        <!-- ===================================================================== -->
        <!-- ==================  (2) PRINCIPAL EDIT COURSE  ====================== -->
        <!-- ===================================================================== -->
        <Grid x:Name="PrincipalEditCourseOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <Grid.Resources>
                <Style x:Key="PrincipalGoldComboItemStyle2" TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="PrincipalGoldComboStyle2" TargetType="ComboBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource PrincipalGoldComboItemStyle2}"/>
                    <Setter Property="Background" Value="Gold"/>
                </Style>

                <Style x:Key="PrincipalGoldTextBoxStyle2" TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="PrincipalGoldDatePickerStyle2" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <Border CornerRadius="10" Padding="18" Width="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="PrincipalEditCourseLangCombo" Grid.Row="0" Grid.Column="1" Style="{StaticResource PrincipalGoldComboStyle2}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="PrincipalEditCourseLevelCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource PrincipalGoldComboStyle2}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Max attendees:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="PrincipalEditCourseMaxBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PrincipalGoldTextBoxStyle2}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Start (date &amp; time):" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,4,0,4">
                        <DatePicker x:Name="PrincipalEditCourseDatePicker" Width="170" Height="35" Style="{StaticResource PrincipalGoldDatePickerStyle2}" SelectedDateFormat="Short"/>
                        <TextBox x:Name="PrincipalEditCourseTimeBox" Width="120" Height="35" Margin="8,0,0,0" Style="{StaticResource PrincipalGoldTextBoxStyle2}" ToolTip="Format: HH:mm (npr. 10:00)"/>
                    </StackPanel>

                    <Label Grid.Row="4" Grid.Column="0" Content="Room (optional):" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="PrincipalEditCourseRoomBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource PrincipalGoldTextBoxStyle2}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Is Live:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <CheckBox x:Name="PrincipalEditCourseIsLiveCheckBox" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="8,4,0,4"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Days:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Top" Margin="0,4"/>
                    <WrapPanel Grid.Row="6" Grid.Column="1" Margin="8,4,0,4">
                        <CheckBox Content="Mon" x:Name="PrincipalEditCourseMonCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Tue" x:Name="PrincipalEditCourseTueCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Wed" x:Name="PrincipalEditCourseWedCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Thu" x:Name="PrincipalEditCourseThuCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Fri" x:Name="PrincipalEditCourseFriCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Sat" x:Name="PrincipalEditCourseSatCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Sun" x:Name="PrincipalEditCourseSunCheckBox" Foreground="White"/>
                    </WrapPanel>

                    <Label Grid.Row="7" Grid.Column="0" Content="Duration (weeks):" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="PrincipalEditCourseDurationWeeksBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource PrincipalGoldTextBoxStyle2}" Height="35" Margin="8,4,0,4"/>

                    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Save" Width="140" Height="38" Margin="8" Click="SaveEditedCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="140" Height="38" Margin="8" Click="CancelEditCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================== /PRINCIPAL EDIT COURSE OVERLAY ================== -->


        <!-- ===================================================================== -->
        <!-- ==================  (3) PRINCIPAL ADD COURSE  ======================= -->
        <!-- ===================================================================== -->
        <Grid x:Name="PrincipalAddCourseOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <Grid.Resources>
                <Style x:Key="PrincipalGoldComboItemStyle3" TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="PrincipalGoldComboStyle3" TargetType="ComboBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource PrincipalGoldComboItemStyle3}"/>
                    <Setter Property="Background" Value="Gold"/>
                </Style>

                <Style x:Key="PrincipalGoldTextBoxStyle3" TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="PrincipalGoldDatePickerStyle3" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <Border CornerRadius="10" Padding="18" Width="640"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="PrincipalAddCourseLangCombo" Grid.Row="0" Grid.Column="1" Style="{StaticResource PrincipalGoldComboStyle3}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="1" Grid.Column="0" Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="PrincipalAddCourseLevelCombo" Grid.Row="1" Grid.Column="1" Style="{StaticResource PrincipalGoldComboStyle3}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="2" Grid.Column="0" Content="Max attendees:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="PrincipalAddCourseMaxBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PrincipalGoldTextBoxStyle3}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="3" Grid.Column="0" Content="Start (date &amp; time):" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,4,0,4">
                        <DatePicker x:Name="PrincipalAddCourseDatePicker" Width="170" Height="35" Style="{StaticResource PrincipalGoldDatePickerStyle3}" SelectedDateFormat="Short"/>
                        <TextBox x:Name="PrincipalAddCourseTimeBox" Width="120" Height="35" Margin="8,0,0,0" Style="{StaticResource PrincipalGoldTextBoxStyle3}" ToolTip="Format: HH:mm (npr. 10:00)"/>
                    </StackPanel>

                    <Label Grid.Row="4" Grid.Column="0" Content="Room (optional):" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="PrincipalAddCourseRoomBox" Grid.Row="4" Grid.Column="1" Style="{StaticResource PrincipalGoldTextBoxStyle3}" Height="35" Margin="8,4,0,4"/>

                    <Label Grid.Row="5" Grid.Column="0" Content="Is Live:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <CheckBox x:Name="PrincipalAddCourseIsLiveCheckBox" Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" Margin="8,4,0,4"/>

                    <Label Grid.Row="6" Grid.Column="0" Content="Days:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Top" Margin="0,4"/>
                    <WrapPanel Grid.Row="6" Grid.Column="1" Margin="8,4,0,4">
                        <CheckBox Content="Mon" x:Name="PrincipalAddCourseMonCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Tue" x:Name="PrincipalAddCourseTueCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Wed" x:Name="PrincipalAddCourseWedCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Thu" x:Name="PrincipalAddCourseThuCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Fri" x:Name="PrincipalAddCourseFriCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Sat" x:Name="PrincipalAddCourseSatCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Sun" x:Name="PrincipalAddCourseSunCheckBox" Foreground="White"/>
                    </WrapPanel>

                    <TextBox x:Name="PrincipalAddCourseDurationWeeksBox" Grid.Row="7" Grid.Column="1" Style="{StaticResource PrincipalGoldTextBoxStyle3}" Height="35" Margin="8,4,0,4">
                        <TextBox.ToolTip>
                            <ToolTip Content="Duration (weeks)"/>
                        </TextBox.ToolTip>
                    </TextBox>

                    <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Save" Width="140" Height="38" Margin="8" Click="SaveNewCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="140" Height="38" Margin="8" Click="CancelAddCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================== /PRINCIPAL ADD COURSE OVERLAY ================== -->


    </Grid>
</Window>
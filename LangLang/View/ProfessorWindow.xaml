                    <Label Grid.Row="7" Grid.Column="0" Content="Duration (weeks):" Foreground="White"
           FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="EditCourseDurationWeeksBox" Grid.Row="7" Grid.Column="1"
             Style="{StaticResource GoldTextBoxStyle}" Height="35" Margin="8,4,0,4"/>

                    <!-- Spacer je Row 8 -->

                    <!-- Buttons -->
                    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal"
            HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Save" Width="140" Height="38" Margin="8"
            Click="SaveEditedCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="140" Height="38" Margin="8"
            Click="CancelEditCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>


        <!-- ================== /EDIT COURSE OVERLAY ================== -->

        <!-- ================== ADD COURSE OVERLAY ================== -->
        <Grid x:Name="AddCourseOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">

            <Border CornerRadius="10" Padding="18" Width="640"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Language -->
                        <RowDefinition Height="Auto"/>
                        <!-- Level -->
                        <RowDefinition Height="Auto"/>
                        <!-- Max -->
                        <RowDefinition Height="Auto"/>
                        <!-- Start date & time -->
                        <RowDefinition Height="Auto"/>
                        <!-- Room -->
                        <RowDefinition Height="Auto"/>
                        <!-- IsLive -->
                        <RowDefinition Height="Auto"/>
                        <!-- Days -->
                        <RowDefinition Height="Auto"/>
                        <!-- DurationWeeks -->
                        <RowDefinition Height="*"/>
                        <!-- Spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Language -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Language:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="AddCourseLangCombo" Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource GoldComboStyle}" Height="35" Margin="8,4,0,4"/>

                    <!-- Level -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Level:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="AddCourseLevelCombo" Grid.Row="1" Grid.Column="1"
                      Style="{StaticResource GoldComboStyle}" Height="35" Margin="8,4,0,4"/>

                    <!-- Max attendees -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Max attendees:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="AddCourseMaxBox" Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource GoldTextBoxStyle}" Height="35" Margin="8,4,0,4"/>

                    <!-- Start date & time -->
                    <Label Grid.Row="3" Grid.Column="0" Content="Start (date &amp; time):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,4,0,4">
                        <DatePicker x:Name="AddCourseDatePicker" Width="170" Height="35"
                            Style="{StaticResource GoldDatePickerStyle}" SelectedDateFormat="Short"/>
                        <TextBox x:Name="AddCourseTimeBox" Width="120" Height="35" Margin="8,0,0,0"
                         Style="{StaticResource GoldTextBoxStyle}"
                         ToolTip="Format: HH:mm (npr. 10:00)"/>
                    </StackPanel>

                    <!-- Room -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Room (optional):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="AddCourseRoomBox" Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource GoldTextBoxStyle}" Height="35" Margin="8,4,0,4"/>

                    <!-- IsLive -->
                    <Label Grid.Row="5" Grid.Column="0" Content="Is Live:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <CheckBox x:Name="AddCourseIsLiveCheckBox" Grid.Row="5" Grid.Column="1"
                      VerticalAlignment="Center" Margin="8,4,0,4"/>

                    <!-- Days -->
                    <Label Grid.Row="6" Grid.Column="0" Content="Days:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Top" Margin="0,4"/>
                    <WrapPanel Grid.Row="6" Grid.Column="1" Margin="8,4,0,4">
                        <CheckBox Content="Mon" x:Name="AddCourseMonCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Tue" x:Name="AddCourseTueCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Wed" x:Name="AddCourseWedCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Thu" x:Name="AddCourseThuCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Fri" x:Name="AddCourseFriCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Sat" x:Name="AddCourseSatCheckBox" Foreground="White" Margin="0,0,8,0"/>
                        <CheckBox Content="Sun" x:Name="AddCourseSunCheckBox" Foreground="White"/>
                    </WrapPanel>

                    <!-- DurationWeeks -->
                    <Label Grid.Row="7" Grid.Column="0" Content="Duration (weeks):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="AddCourseDurationWeeksBox" Grid.Row="7" Grid.Column="1"
                     Style="{StaticResource GoldTextBoxStyle}" Height="35" Margin="8,4,0,4"/>

                    <!-- Spacer je Row 8 -->

                    <!-- Buttons -->
                    <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal"
            HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Save" Width="140" Height="38" Margin="8"
            Click="SaveNewCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="140" Height="38" Margin="8"
            Click="CancelAddCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================== /ADD COURSE OVERLAY ================== -->


    </Grid>
</Window>
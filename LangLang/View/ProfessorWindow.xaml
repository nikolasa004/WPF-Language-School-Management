<Window x:Class="LangLang.RoleWindows.ProfessorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:LangLang.Converters"
        xmlns:local="clr-namespace:LangLang.Model.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="ProfessorWindow" 
        Height="450" Width="800"
        Icon="/GUIResources/icon.ico">

    <Window.Resources>
        <conv:DateToStringConverter x:Key="DateToStringConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>

        <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="EducationValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:EducationLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ControlTemplate x:Key="ValidationTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="textBox" />
                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red" FontFamily="Script MT Bold" HorizontalAlignment="Right" Background="#80000000"/>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <!-- Main panel -->
        <Grid x:Name="MainPanel" Visibility="Visible">
            <Viewbox Stretch="Uniform">
                <Grid Width="600" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Top bar -->
                        <RowDefinition Height="*"/>
                        <!-- Professor info -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom buttons -->
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Grid Grid.Row="0" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Navigation buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">

                            <!-- Courses Button -->

                            <Button x:Name="CoursesButton" 
                                    Content="Courses" 
                                    Style="{StaticResource FancyButtonStyle}" 
                                    FontSize="20" 
                                    Width="100" 
                                    Height="35" 
                                    Click="CoursesButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>

                            </Button>


                            <!-- Exams Button -->
                            <Button x:Name="ExamsButton" 
                                    Content="Exams" 
                                    Style="{StaticResource FancyButtonStyle}" 
                                    FontSize="20" 
                                    Width="100" 
                                    Height="35" 
                                    Click="ExamsButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>

                            </Button>
                        </StackPanel>


                        <!-- Inbox button or whatever else on the right -->
                        <Button Content="" Style="{StaticResource FancyButtonStyle}" Width="40" Height="40" HorizontalAlignment="Right" Grid.Column="1">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/inbox.png"/>
                            </Button.Background>
                        </Button>
                    </Grid>

                    <!-- Professor info -->
                    <Grid Grid.Row="1" Margin="0,20,0,0" Background="#80000000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <Label x:Name="NameLabel" Content="Name: John" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="SurnameLabel" Content="Surname: Doe" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="GenderLabel" Content="Gender: Male" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="BirthDateLabel" Content="Birth Date: 01.01.1970" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="PhoneLabel" Content="Phone: 1234567890" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Label x:Name="EmailLabel" Content="Email: john@example.com" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="EducationLabel" Content="Education: Master" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <TextBlock x:Name="LanguagesLabel" Text="Languages: English - Advanced, Spanish - Intermediate, French - Beginner" 
               FontSize="20" Foreground="White" FontFamily="Script MT Bold" TextWrapping="Wrap"/>
                            <Label x:Name="JoinedDateLabel" Content="Joined Date: 01.09.2000" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- OLD BUTTONS-->
                </Grid>
            </Viewbox>
        </Grid>
        <!-- Courses panel -->
        <Grid x:Name="CoursesPanel" Visibility="Collapsed" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Filters (top row) -->
            <WrapPanel Grid.Row="0" Background="#66000000" ItemHeight="35">
                <Label Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="CourseLanguageCombo" Style="{StaticResource GoldComboStyle}" Width="170" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="CourseLevelCombo" Style="{StaticResource GoldComboStyle}" Width="170" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="Live:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="CourseOnlineCombo" Style="{StaticResource GoldComboStyle}" Width="75" Height="35" Margin="6,6,12,6" VerticalAlignment="Center">
                    <ComboBoxItem Content="Yes"/>
                    <ComboBoxItem Content="No"/>
                </ComboBox>

                <Label Content="Weeks:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <TextBox x:Name="CourseWeeksBox" Width="50" Height="35" Margin="6,6,12,6" VerticalAlignment="Center" Background="Gold" FontFamily="Script MT Bold" Foreground="White" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                <Label Content="From:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="CourseFromDate" Style="{StaticResource GoldDatePickerStyle}" Width="160" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Label Content="To:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="CourseToDate" Style="{StaticResource GoldDatePickerStyle}" Width="160" Height="35" Margin="6,6,12,6" VerticalAlignment="Center"/>

                <Button Content="Search" Style="{StaticResource FancyButtonStyle}" FontSize="16" Width="120" Height="35" Margin="12,6,0,6" VerticalAlignment="Center" Click="CoursesSearch_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>
            </WrapPanel>

            <!-- Courses table (middle row)-->
            <DataGrid x:Name="CoursesGrid"
          Grid.Row="1"
          Margin="0,8,0,8"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          CanUserSortColumns="True"
          Sorting="CoursesGrid_Sorting"
          Background="#66000000"
          Foreground="White"
          FontFamily="Script MT Bold"
          GridLinesVisibility="None"
          HeadersVisibility="Column"
          RowBackground="#33000000"
          AlternatingRowBackground="#22000000"
          BorderBrush="#00000000">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                    <Style TargetType="DataGridCell"         BasedOn="{StaticResource DGCellStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"         Binding="{Binding Id}"            SortMemberPath="Id"            Width="60"/>
                    <DataGridTextColumn Header="Language"   Binding="{Binding Language}"      SortMemberPath="Language"      Width="*"/>
                    <DataGridTextColumn Header="Level"      Binding="{Binding Level}"         SortMemberPath="Level"         Width="*"/>
                    <DataGridTextColumn Header="Start date" Binding="{Binding Date}"          SortMemberPath="Date"          Width="110"/>
                    <DataGridTextColumn Header="Professor"  Binding="{Binding ProfessorId}"   SortMemberPath="ProfessorId"   Width="*"/>
                    <DataGridTextColumn Header="Weeks"      Binding="{Binding DurationWeeks}" SortMemberPath="DurationWeeks" Width="*"/>
                    <DataGridTextColumn Header="Days"       Binding="{Binding DaysFormatted}" SortMemberPath="DaysFormatted" Width="*"/>
                    <DataGridTextColumn Header="Start"      Binding="{Binding StartAt}"       SortMemberPath="StartAt"       Width="*"/>
                    <DataGridTextColumn Header="Live"       Binding="{Binding IsLive}"        SortMemberPath="IsLive"        Width="80"/>
                    <DataGridTextColumn Header="Room"       Binding="{Binding RoomId}"        SortMemberPath="RoomId"        Width="80"/>
                    <DataGridTextColumn Header="Max"        Binding="{Binding MaxAttendees}"  SortMemberPath="MaxAttendees"  Width="80"/>

                    <!-- Actions column -->
                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit" Style="{StaticResource FancyButtonStyle}" Width="70" Height="30" Margin="2,0"
                                Click="EditCourse_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button Content="Delete" Style="{StaticResource FancyButtonStyle}" Width="80" Height="30" Margin="6,0,0,0"
                                Click="DeleteCourse_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button x:Name="StartCourseButton" Content="Start Course" Style="{StaticResource FancyButtonStyle}" Width="70" Height="30" Margin="2,0"
                          Click="StartCourseButton_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
            <!-- Bottom row -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <!-- Left: Back -->
                    <ColumnDefinition Width="Auto"/>
                    <!-- Middle: Add -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Pagination -->
                </Grid.ColumnDefinitions>

                <!-- Back button-->
                <Button Grid.Column="0" Content="Back" Style="{StaticResource FancyButtonStyle}" FontSize="16" Width="120" Height="38" Margin="6,0" Click="CloseCoursesPanel_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>

                <!-- Add button-->
                <Button Grid.Column="1" Content="Add" Style="{StaticResource FancyButtonStyle}" FontSize="16" Width="120" Height="38" Margin="6,0" Click="AddCourseButton_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>

                <!-- Pagination -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Per page:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PageSizeComboCourses" Width="70" Height="34" Margin="0,0,12,0" SelectionChanged="PageSizeComboCourses_SelectionChanged">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10" IsSelected="True"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>

                    <Button x:Name="PrevPageBtnCourses" Content="◀ Prev" Style="{StaticResource FancyButtonStyle}" Width="90" Height="34" Margin="6,0" Click="PrevPageCourses_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                    <!-- Uses ApplyFiltersSortAndPage in code -->
                    <TextBlock x:Name="PagerTextCourses" Text="Page 1/1 · 0 items" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="8,0"/>

                    <Button x:Name="NextPageBtnCourses" Content="Next ▶" Style="{StaticResource FancyButtonStyle}" Width="90" Height="34" Margin="6,0" Click="NextPageCourses_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>


        <!-- ================== START COURSE OVERLAY ================== -->
        <Grid x:Name="StartCourseOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">

            <Border CornerRadius="10" Padding="18" Width="850" MinHeight="500"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Title -->
                        <RowDefinition Height="*"/>
                        <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0" Text="Students in Course"
                       Foreground="Gold"
                       FontSize="22"
                       FontFamily="Script MT Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

                    <!-- Students DataGrid -->
                    <DataGrid x:Name="StudentsGrid"
                      Grid.Row="1"
                      Margin="0,8,0,8"
                      AutoGenerateColumns="False"
                      IsReadOnly="False"
                                        CanUserAddRows="False"
          CanUserDeleteRows="False"
         
                      CanUserSortColumns="True"
                      VerticalAlignment="Stretch"
                      Background="#66000000"
                      Foreground="White"
                      FontFamily="Script MT Bold"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowBackground="#33000000"
                      AlternatingRowBackground="#22000000"
                      BorderBrush="#00000000">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                            <Style TargetType="DataGridCell"         BasedOn="{StaticResource DGCellStyle}"/>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <!-- Text columns (readonly) -->
                            <DataGridTextColumn Header="First Name"  Binding="{Binding FirstName}"   Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Last Name"   Binding="{Binding LastName}"    Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Gender"      Binding="{Binding Gender}"      Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Email"       Binding="{Binding Email}"       Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Phone"       Binding="{Binding PhoneNumber}" Width="*" IsReadOnly="True"/>
                            <DataGridTextColumn Header="Penalty"     Binding="{Binding PenaltyPoints}" Width="100" IsReadOnly="True"/>

                            <DataGridTemplateColumn Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Reject"
                        Width="140" Height="38"
                        Margin="6,0"
                        Click="RejectStudent_Click"
                        Style="{StaticResource FancyButtonStyle}">
                                                <Button.Background>
                                                    <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                                </Button.Background>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Bottom Buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Close" Width="140" Height="38" Margin="8"
                        Click="CloseStartCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Start" Width="140" Height="38" Margin="8"
                        Click="StartCourse_Click" Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================== /VIEW STUDENTS OVERLAY ================== -->










        <Grid x:Name="ExamsPanel" Visibility="Collapsed" Background="Transparent">
            <!-- TOP (Auto) / MIDDLE (*) / BOTTOM (Auto) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ====== LOCAL RESOURCES (samo za ExamsPanel) ====== -->
            <Grid.Resources>
                <!-- GLOBAL (Window.Resources) -->
                <Style x:Key="GoldComboItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD24D"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0B000"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="GoldComboStyle" TargetType="ComboBox">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource GoldComboItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid SnapsToDevicePixels="True">
                                    <!-- gornja kutija -->
                                    <Border Background="Gold"
                     BorderBrush="{TemplateBinding BorderBrush}"
                     BorderThickness="{TemplateBinding BorderThickness}"
                     CornerRadius="4">
                                        <DockPanel>
                                            <ToggleButton x:Name="PART_DropDownToggle"
                                   DockPanel.Dock="Right"
                                   Focusable="False"
                                   IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   ClickMode="Press"
                                   Background="Gold"
                                   BorderThickness="0"
                                   Width="28">
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>
                                            <ContentPresenter Margin="6,0,6,0"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- dropdown -->
                                    <Popup x:Name="PART_Popup"
                    Placement="Bottom"
                    IsOpen="{TemplateBinding IsDropDownOpen}"
                    AllowsTransparency="True"
                    Focusable="False"
                    PopupAnimation="Slide">
                                        <Border Background="Gold" Margin="0,2,0,0"
                         BorderBrush="{TemplateBinding BorderBrush}"
                         BorderThickness="2" CornerRadius="4">
                                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- DatePicker u istom tonu (Gold) -->
                <Style x:Key="GoldDatePickerStyle" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#33000000"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <!-- DataGrid stilovi -->
                <Style x:Key="DGHeaderStyle" TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#88000000"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
                <Style x:Key="DGCellStyle" TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="BorderBrush" Value="#00000000"/>
                    <Setter Property="Padding" Value="6,2"/>
                </Style>
            </Grid.Resources>

            <!-- ====== FILTERI (skroz gore) ====== -->
            <WrapPanel Grid.Row="0" Background="#66000000" ItemHeight="35">
                <Label Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExamLanguageCombo"
           Style="{StaticResource GoldComboStyle}"
           Width="170" Height="35"
           Margin="6,6,12,6"
           VerticalAlignment="Center"/>

                <Label Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExamLevelCombo"
           Style="{StaticResource GoldComboStyle}"
           Width="170" Height="35"
           Margin="6,6,12,6"
           VerticalAlignment="Center"/>

                <Label Content="From:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="ExamFromDate"
             Style="{StaticResource GoldDatePickerStyle}"
             Width="160" Height="35"
             Margin="6,6,12,6"
             VerticalAlignment="Center"/>

                <Label Content="To:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="ExamToDate"
             Style="{StaticResource GoldDatePickerStyle}"
             Width="160" Height="35"
             Margin="6,6,12,6"
             VerticalAlignment="Center"/>

                <Button Content="Search"
         Style="{StaticResource FancyButtonStyle}"
         FontSize="16"
         Width="120" Height="35"
         Margin="12,6,0,6"
         VerticalAlignment="Center"
         Click="FindYourExams_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>
            </WrapPanel>

            <!-- ====== LISTA ISPITA ====== -->
            <DataGrid x:Name="ExamsGrid"
              Grid.Row="1"
              Margin="0,8,0,8"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              Sorting="ExamsGrid_Sorting"
              Background="#66000000"
              Foreground="White"
              FontFamily="Script MT Bold"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              RowBackground="#33000000"
              AlternatingRowBackground="#22000000"
              BorderBrush="#00000000">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                    <Style TargetType="DataGridCell"         BasedOn="{StaticResource DGCellStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"        Binding="{Binding Id}"            SortMemberPath="Id"           Width="60"/>
                    <DataGridTextColumn Header="Language"  Binding="{Binding Language}"      SortMemberPath="Language"     Width="*"/>
                    <DataGridTextColumn Header="Level"     Binding="{Binding Level}"         SortMemberPath="Level"        Width="*"/>
                    <DataGridTextColumn Header="Date"      Binding="{Binding Date}"          SortMemberPath="Date"         Width="110"/>
                    <DataGridTextColumn Header="Start"     Binding="{Binding StartAt}"       SortMemberPath="StartAt"      Width="80"/>
                    <DataGridTextColumn Header="Room"      Binding="{Binding RoomId}"        SortMemberPath="RoomId"       Width="80"/>
                    <DataGridTextColumn Header="Max"       Binding="{Binding MaxAttendees}"  SortMemberPath="MaxAttendees" Width="80"/>
                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit"   Style="{StaticResource FancyButtonStyle}" Width="70" Height="30" Margin="2,0" Click="EditExam_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button Content="Cancel" Style="{StaticResource FancyButtonStyle}" Width="80" Height="30" Margin="6,0,0,0" Click="CancelExam_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>


<Window x:Class="LangLang.View.RateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rate Teacher" Height="500" Width="800"
        Icon="/GUIResources/icon.ico">

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Label -->
        <Label Content="Label" x:Name="TopLabel" Grid.Row="0" FontSize="30" FontFamily="Script MT Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,20,0,20"/>

        <!-- Stars/Circles -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,20">
            <ItemsControl x:Name="StarsPanel" HorizontalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>

        <!-- Send button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <Button Content="Send" Width="150" Height="80" FontFamily="Script MT Bold" FontSize="35" Style="{StaticResource FancyButtonStyle}" Click="SendButton_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                </Button.Background>
            </Button>
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="LangLang.View.MessageSendWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="New Message" Height="450" Width="800"
        Icon="/GUIResources/icon.ico">

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Label -->
        <Label x:Name="MessageLabel" Content="Label" Grid.Row="0" FontSize="30" FontFamily="Script MT Bold" Foreground="White" HorizontalAlignment="Center"/>

        <!-- TextBox -->
        <TextBox x:Name="MessageTextBox" Grid.Row="1" Margin="5,0" FontSize="16" FontFamily="Segoe UI" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Padding="10" Background="#AA000000" Foreground="White" BorderBrush="Gray" BorderThickness="2"/>

        <!-- Send button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <Button Content="Send" Width="150" Height="80" FontFamily="Script MT Bold" FontSize="35" Style="{StaticResource FancyButtonStyle}" Click="SendButton_Click">
                <Button.Background>
                    <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                </Button.Background>
            </Button>
        </StackPanel>
    </Grid>
</Window>
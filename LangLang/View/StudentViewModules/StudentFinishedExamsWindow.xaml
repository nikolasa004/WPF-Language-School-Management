<Window x:Class="LangLang.View.StudentViewModules.StudentFinishedExamsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Finished Exams"
        Height="400" Width="600"
        Icon="/GUIResources/icon.ico">

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Table -->
            <DataGrid x:Name="ExamsGrid"
                      Grid.Row="0"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserSortColumns="True"
                      Background="#66000000"
                      Foreground="White"
                      FontFamily="Script MT Bold"
                      GridLinesVisibility="None"
                      HeadersVisibility="Column"
                      RowBackground="#33000000"
                      AlternatingRowBackground="#22000000"
                      BorderBrush="#00000000">
                <DataGrid.Resources>
                    <!-- koristi postojeće stilove ako su definisani u App.xaml -->
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                    <Style TargetType="DataGridCell"         BasedOn="{StaticResource DGCellStyle}"/>
                </DataGrid.Resources>

                <!-- Tuple<Language, LanguageLevel> => Item1 / Item2 -->
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Language" Binding="{Binding Item1}" SortMemberPath="Item1" Width="*"/>
                    <DataGridTextColumn Header="Level"    Binding="{Binding Item2}" SortMemberPath="Item2" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Close -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                <Button Content="Close" Width="120" Height="38" FontSize="16"
                        Style="{StaticResource FancyButtonStyle}"
                        Click="CloseButton_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>

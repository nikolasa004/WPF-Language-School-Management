<Window x:Class="LangLang.View.StudentViewModules.StudentFinishedLevelsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LangLang.Model.Enums"
        Title="Languages"
        Height="400" Width="600"
        Icon="/GUIResources/icon.ico">

    <Grid>
        <!-- Background -->
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Table -->
            <DataGrid x:Name="LanguagesGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True" Background="#66000000" Foreground="White" FontFamily="Script MT Bold" GridLinesVisibility="None" HeadersVisibility="Column" RowBackground="#33000000" AlternatingRowBackground="#22000000" BorderBrush="#00000000">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource DGCellStyle}"/>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Language" Binding="{Binding Item1}" SortMemberPath="Language" Width="*"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding Item2}" SortMemberPath="Level" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
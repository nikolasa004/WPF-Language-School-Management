<Window x:Class="LangLang.RoleWindows.ProfessorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:conv="clr-namespace:LangLang.Converters"
        xmlns:local="clr-namespace:LangLang.Model.Enums"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="ProfessorWindow" 
        Height="450" Width="800"
        Icon="/GUIResources/icon.ico">

    <Window.Resources>
        <conv:DateToStringConverter x:Key="DateToStringConverter"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>

        <ObjectDataProvider MethodName="GetValues" ObjectType="{x:Type sys:Enum}" x:Key="EducationValues">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="local:EducationLevel"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <ControlTemplate x:Key="ValidationTemplate">
            <StackPanel>
                <AdornedElementPlaceholder x:Name="textBox" />
                <TextBlock Text="{Binding [0].ErrorContent}" Foreground="Red" FontFamily="Script MT Bold" HorizontalAlignment="Right" Background="#80000000"/>
            </StackPanel>
        </ControlTemplate>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <!-- Main panel -->
        <Grid x:Name="MainPanel" Visibility="Visible">
            <Viewbox Stretch="Uniform">
                <Grid Width="600" Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Top bar -->
                        <RowDefinition Height="*"/>
                        <!-- Professor info -->
                        <RowDefinition Height="Auto"/>
                        <!-- Bottom buttons -->
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Grid Grid.Row="0" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Navigation buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">

                            <!-- Courses Button -->
                            <Button x:Name="CoursesButton" Content="Courses" Style="{StaticResource FancyButtonStyle}" FontSize="20" Width="100" Height="35" Click="CoursesButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="CoursesContextMenu" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>

                                        <MenuItem Header="Show your courses">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Find your courses">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Sort and paginate your courses">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Start a course">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Ongoing courses">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="End course">
                                            <MenuItem.Icon>
                                                <Image Source="/GUIResources/star.png" Width="16" Height="16"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Exams Button -->
                            <Button x:Name="ExamsButton" 
                                    Content="Exams" 
                                    Style="{StaticResource FancyButtonStyle}" 
                                    FontSize="20" 
                                    Width="100" 
                                    Height="35" 
                                    Click="ExamsButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>

                            </Button>
                        </StackPanel>


                        <!-- Inbox button or whatever else on the right -->
                        <Button Content="" Style="{StaticResource FancyButtonStyle}" Width="40" Height="40" HorizontalAlignment="Right" Grid.Column="1">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/inbox.png"/>
                            </Button.Background>
                        </Button>
                    </Grid>

                    <!-- Professor info -->
                    <Grid Grid.Row="1" Margin="0,20,0,0" Background="#80000000">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Top">
                            <Label x:Name="NameLabel" Content="Name: John" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="SurnameLabel" Content="Surname: Doe" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="GenderLabel" Content="Gender: Male" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="BirthDateLabel" Content="Birth Date: 01.01.1970" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="PhoneLabel" Content="Phone: 1234567890" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                            <Label x:Name="EmailLabel" Content="Email: john@example.com" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <Label x:Name="EducationLabel" Content="Education: Master" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                            <TextBlock x:Name="LanguagesLabel" Text="Languages: English - Advanced, Spanish - Intermediate, French - Beginner" 
               FontSize="20" Foreground="White" FontFamily="Script MT Bold" TextWrapping="Wrap"/>
                            <Label x:Name="JoinedDateLabel" Content="Joined Date: 01.09.2000" FontSize="20" Foreground="White" FontFamily="Script MT Bold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Add Course" Style="{StaticResource FancyButtonStyle}" Width="150" Height="70" Margin="10,0" FontSize="20" Click="AddCourse_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Add Exam" Style="{StaticResource FancyButtonStyle}" Width="150" Height="70" Margin="10,0" FontSize="20" Click="AddExam_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- EXAMS PANEL -->
        <Grid x:Name="ExamsPanel" Visibility="Collapsed" Background="Transparent">
            <!-- TOP (Auto) / MIDDLE (*) / BOTTOM (Auto) -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ====== LOCAL RESOURCES (samo za ExamsPanel) ====== -->
            <Grid.Resources>
                <!-- GLOBAL (Window.Resources) -->
                <Style x:Key="GoldComboItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD24D"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0B000"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="GoldComboStyle" TargetType="ComboBox">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource GoldComboItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid SnapsToDevicePixels="True">
                                    <!-- gornja kutija -->
                                    <Border Background="Gold"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                                        <DockPanel>
                                            <ToggleButton x:Name="PART_DropDownToggle"
                                          DockPanel.Dock="Right"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Background="Gold"
                                          BorderThickness="0"
                                          Width="28">
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="White"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>
                                            <ContentPresenter Margin="6,0,6,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- dropdown -->
                                    <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                                        <Border Background="Gold" Margin="0,2,0,0"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2" CornerRadius="4">
                                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- DatePicker u istom tonu (Gold) -->
                <Style x:Key="GoldDatePickerStyle" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#33000000"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <!-- DataGrid stilovi -->
                <Style x:Key="DGHeaderStyle" TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#88000000"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,4"/>
                </Style>
                <Style x:Key="DGCellStyle" TargetType="DataGridCell">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="BorderBrush" Value="#00000000"/>
                    <Setter Property="Padding" Value="6,2"/>
                </Style>
            </Grid.Resources>

            <!-- ====== FILTERI (skroz gore) ====== -->
            <WrapPanel Grid.Row="0" Background="#66000000" ItemHeight="35">
                <Label Content="Language:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExamLanguageCombo"
                  Style="{StaticResource GoldComboStyle}"
                  Width="170" Height="35"
                  Margin="6,6,12,6"
                  VerticalAlignment="Center"/>

                <Label Content="Level:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <ComboBox x:Name="ExamLevelCombo"
                  Style="{StaticResource GoldComboStyle}"
                  Width="170" Height="35"
                  Margin="6,6,12,6"
                  VerticalAlignment="Center"/>

                <Label Content="From:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="ExamFromDate"
                    Style="{StaticResource GoldDatePickerStyle}"
                    Width="160" Height="35"
                    Margin="6,6,12,6"
                    VerticalAlignment="Center"/>

                <Label Content="To:" Foreground="White" FontFamily="Script MT Bold" VerticalAlignment="Center"/>
                <DatePicker x:Name="ExamToDate"
                    Style="{StaticResource GoldDatePickerStyle}"
                    Width="160" Height="35"
                    Margin="6,6,12,6"
                    VerticalAlignment="Center"/>

                <Button Content="Search"
                Style="{StaticResource FancyButtonStyle}"
                FontSize="16"
                Width="120" Height="35"
                Margin="12,6,0,6"
                VerticalAlignment="Center"
                Click="FindYourExams_Click">
                    <Button.Background>
                        <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                    </Button.Background>
                </Button>
            </WrapPanel>

            <!-- ====== LISTA ISPITA ====== -->
            <DataGrid x:Name="ExamsGrid"
              Grid.Row="1"
              Margin="0,8,0,8"
              AutoGenerateColumns="False"
              IsReadOnly="True"
              CanUserSortColumns="True"
              Sorting="ExamsGrid_Sorting"
              Background="#66000000"
              Foreground="White"
              FontFamily="Script MT Bold"
              GridLinesVisibility="None"
              HeadersVisibility="Column"
              RowBackground="#33000000"
              AlternatingRowBackground="#22000000"
              BorderBrush="#00000000">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource DGHeaderStyle}"/>
                    <Style TargetType="DataGridCell"         BasedOn="{StaticResource DGCellStyle}"/>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID"        Binding="{Binding Id}"            SortMemberPath="Id"           Width="60"/>
                    <DataGridTextColumn Header="Language"  Binding="{Binding Language}"      SortMemberPath="Language"     Width="*"/>
                    <DataGridTextColumn Header="Level"     Binding="{Binding Level}"         SortMemberPath="Level"        Width="*"/>
                    <DataGridTextColumn Header="Date"      Binding="{Binding Date}"          SortMemberPath="Date"         Width="110"/>
                    <DataGridTextColumn Header="Start"     Binding="{Binding StartAt}"       SortMemberPath="StartAt"      Width="80"/>
                    <DataGridTextColumn Header="Room"      Binding="{Binding RoomId}"        SortMemberPath="RoomId"       Width="80"/>
                    <DataGridTextColumn Header="Max"       Binding="{Binding MaxAttendees}"  SortMemberPath="MaxAttendees" Width="80"/>
                    <DataGridTemplateColumn Header="Actions" Width="180">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Edit"   Style="{StaticResource FancyButtonStyle}" Width="70" Height="30" Margin="2,0" Click="EditExam_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                    <Button Content="Cancel" Style="{StaticResource FancyButtonStyle}" Width="80" Height="30" Margin="6,0,0,0" Click="CancelExam_Click">
                                        <Button.Background>
                                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                                        </Button.Background>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- ====== DNO: Back + Add (levo) | Pagination (desno) ====== -->
            <Grid Grid.Row="2" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Levo: Back + Add -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Back" Style="{StaticResource FancyButtonStyle}" FontSize="16"
                Width="120" Height="38" Margin="6,0" Click="CloseExamsPanel_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                    <Button Content="Add"  Style="{StaticResource FancyButtonStyle}" FontSize="16"
                Width="120" Height="38" Margin="12,0,6,0" Click="AddExam_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>

                <!-- Desno: Paginacija -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Per page:" Foreground="White" FontFamily="Script MT Bold"
                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="PageSizeCombo" Width="70" Height="34" Margin="0,0,12,0"
                  SelectionChanged="PageSizeCombo_SelectionChanged">
                        <ComboBoxItem Content="5"/>
                        <ComboBoxItem Content="10" IsSelected="True"/>
                        <ComboBoxItem Content="20"/>
                        <ComboBoxItem Content="50"/>
                    </ComboBox>

                    <Button x:Name="PrevPageBtn" Content="◀ Prev" Style="{StaticResource FancyButtonStyle}"
                Width="90" Height="34" Margin="6,0" Click="PrevPage_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>

                    <!-- VAŽNO: ovo ime koristi ApplyFiltersSortAndPage u code-behind-u -->
                    <TextBlock x:Name="PagerText" Text="Page 1/1 · 0 items"
                   Foreground="White" FontFamily="Script MT Bold"
                   VerticalAlignment="Center" Margin="8,0"/>

                    <Button x:Name="NextPageBtn" Content="Next ▶" Style="{StaticResource FancyButtonStyle}"
                Width="90" Height="34" Margin="6,0" Click="NextPage_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- ================== ADD EXAM OVERLAY (gold theme, same background as main window) ================== -->
        <Grid x:Name="AddExamOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <!-- Local resources just for this overlay -->
            <Grid.Resources>
                <!-- Gold ComboBox item -->
                <Style x:Key="GoldComboItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD24D"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0B000"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- HARD gold ComboBox: box + dropdown -->
                <Style x:Key="GoldComboStyle" TargetType="{x:Type ComboBox}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource GoldComboItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBox}">
                                <Grid SnapsToDevicePixels="True">
                                    <!-- top box -->
                                    <Border Background="Gold"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                        <DockPanel>
                                            <ToggleButton x:Name="PART_DropDownToggle"
                                                  DockPanel.Dock="Right"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Gold"
                                                  BorderThickness="0"
                                                  Width="28">
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z"
                                              Fill="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>
                                            <ContentPresenter Margin="6,0,6,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </Border>

                                    <!-- dropdown -->
                                    <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                        <Border Background="Gold"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <!-- Gold DatePicker (same as search) -->
                <Style x:Key="GoldDatePickerStyle" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#33000000"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <!-- Gold TextBox -->
                <Style x:Key="GoldTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <!-- Panel body: same background image as main window -->
            <Border CornerRadius="10" Padding="18" Width="640"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Language -->
                        <RowDefinition Height="Auto"/>
                        <!-- Level -->
                        <RowDefinition Height="Auto"/>
                        <!-- Max -->
                        <RowDefinition Height="Auto"/>
                        <!-- Start -->
                        <RowDefinition Height="Auto"/>
                        <!-- Room -->
                        <RowDefinition Height="20"/>
                        <!-- Spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Language -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Language:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="AddExamLangCombo" Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource GoldComboStyle}"
                      Height="35" Margin="8,4,0,4"/>

                    <!-- Level -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Level:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="AddExamLevelCombo" Grid.Row="1" Grid.Column="1"
                      Style="{StaticResource GoldComboStyle}"
                      Height="35" Margin="8,4,0,4"/>

                    <!-- Max attendees -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Max attendees:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="AddExamMaxBox" Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource GoldTextBoxStyle}"
                     Height="35" Margin="8,4,0,4"/>

                    <!-- Start (date & time) -->
                    <Label Grid.Row="3" Grid.Column="0" Content="Start (date &amp; time):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,4,0,4">
                        <DatePicker x:Name="AddExamDatePicker" Width="170" Height="35"
                            Style="{StaticResource GoldDatePickerStyle}" SelectedDateFormat="Short"/>
                        <!-- HH:mm text box -->
                        <TextBox x:Name="AddExamTimeBox" Width="120" Height="35" Margin="8,0,0,0"
                         Style="{StaticResource GoldTextBoxStyle}"
                         ToolTip="Format: HH:mm (npr. 10:00)"/>
                    </StackPanel>

                    <!-- Room -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Room (optional):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="AddExamRoomBox" Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource GoldTextBoxStyle}"
                     Height="35" Margin="8,4,0,4"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Save" Width="140" Height="38" Margin="8"
                        Click="SaveNewExam_Click"
                        Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="140" Height="38" Margin="8"
                        Click="CancelNewExam_Click"
                        Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ================== EDIT EXAM OVERLAY (gold theme, same background as main window) ================== -->
        <Grid x:Name="EditExamOverlay" Visibility="Collapsed" Background="Transparent" Panel.ZIndex="999">
            <!-- Local resources for this overlay (copy of Add styles so izgled bude identičan) -->
            <Grid.Resources>
                <Style x:Key="EditGoldComboItemStyle" TargetType="ComboBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="Padding" Value="8,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#FFD24D"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#E0B000"/>
                                        <Setter Property="Foreground" Value="Black"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="EditGoldComboStyle" TargetType="{x:Type ComboBox}">
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="SnapsToDevicePixels" Value="True"/>
                    <Setter Property="ItemContainerStyle" Value="{StaticResource EditGoldComboItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type ComboBox}">
                                <Grid SnapsToDevicePixels="True">
                                    <Border Background="Gold"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4">
                                        <DockPanel>
                                            <ToggleButton x:Name="PART_DropDownToggle"
                                                  DockPanel.Dock="Right"
                                                  Focusable="False"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press"
                                                  Background="Gold"
                                                  BorderThickness="0"
                                                  Width="28">
                                                <Path Data="M 0 0 L 8 0 L 4 4 Z"
                                              Fill="White"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </ToggleButton>
                                            <ContentPresenter Margin="6,0,6,0"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </DockPanel>
                                    </Border>

                                    <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                        <Border Background="Gold"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="2"
                                        CornerRadius="4"
                                        Margin="0,2,0,0">
                                            <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                                <StackPanel IsItemsHost="True"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="EditGoldDatePickerStyle" TargetType="DatePicker">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style TargetType="DatePickerTextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#33000000"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>

                <Style x:Key="EditGoldTextBoxStyle" TargetType="TextBox">
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="FontFamily" Value="Script MT Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Background" Value="Gold"/>
                    <Setter Property="BorderBrush" Value="#B8860B"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Padding" Value="6,2"/>
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                </Style>
            </Grid.Resources>

            <!-- Body (ista pozadina kao glavni prozor) -->
            <Border CornerRadius="10" Padding="18" Width="640"
            HorizontalAlignment="Center" VerticalAlignment="Center"
            BorderBrush="#B8860B" BorderThickness="2">
                <Border.Background>
                    <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
                </Border.Background>

                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Language -->
                        <RowDefinition Height="Auto"/>
                        <!-- Level -->
                        <RowDefinition Height="Auto"/>
                        <!-- Max -->
                        <RowDefinition Height="Auto"/>
                        <!-- Start -->
                        <RowDefinition Height="Auto"/>
                        <!-- Room -->
                        <RowDefinition Height="20"/>
                        <!-- Spacer -->
                        <RowDefinition Height="Auto"/>
                        <!-- Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Language -->
                    <Label Grid.Row="0" Grid.Column="0" Content="Language:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="EditExamLangCombo" Grid.Row="0" Grid.Column="1"
                      Style="{StaticResource EditGoldComboStyle}"
                      Height="35" Margin="8,4,0,4"/>

                    <!-- Level -->
                    <Label Grid.Row="1" Grid.Column="0" Content="Level:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <ComboBox x:Name="EditExamLevelCombo" Grid.Row="1" Grid.Column="1"
                      Style="{StaticResource EditGoldComboStyle}"
                      Height="35" Margin="8,4,0,4"/>

                    <!-- Max attendees -->
                    <Label Grid.Row="2" Grid.Column="0" Content="Max attendees:" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="EditExamMaxBox" Grid.Row="2" Grid.Column="1"
                     Style="{StaticResource EditGoldTextBoxStyle}"
                     Height="35" Margin="8,4,0,4"/>

                    <!-- Start (date & time) -->
                    <Label Grid.Row="3" Grid.Column="0" Content="Start (date &amp; time):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="8,4,0,4">
                        <DatePicker x:Name="EditExamDatePicker" Width="170" Height="35"
                            Style="{StaticResource EditGoldDatePickerStyle}" SelectedDateFormat="Short"/>
                        <TextBox x:Name="EditExamTimeBox" Width="120" Height="35" Margin="8,0,0,0"
                         Style="{StaticResource EditGoldTextBoxStyle}"
                         ToolTip="Format: HH:mm (npr. 10:00)"/>
                    </StackPanel>

                    <!-- Room -->
                    <Label Grid.Row="4" Grid.Column="0" Content="Room (optional):" Foreground="White"
                   FontFamily="Script MT Bold" VerticalAlignment="Center" Margin="0,4"/>
                    <TextBox x:Name="EditExamRoomBox" Grid.Row="4" Grid.Column="1"
                     Style="{StaticResource EditGoldTextBoxStyle}"
                     Height="35" Margin="8,4,0,4"/>

                    <!-- Buttons -->
                    <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" Margin="0,6,0,0">
                        <Button Content="Save" Width="140" Height="38" Margin="8"
                        Click="SaveEditedExam_Click"
                        Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Cancel" Width="140" Height="38" Margin="8"
                        Click="CancelEditExam_Click"
                        Style="{StaticResource FancyButtonStyle}">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
        <!-- ================== /EDIT EXAM OVERLAY ================== -->

        <!-- Add Course panel -->
        <Grid x:Name="AddCoursePanel" Visibility="Collapsed">
            <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid Width="600" Margin="10,10,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Language -->
                    <Label Content="Language:" FontSize="16" Foreground="White" Grid.Row="0" Grid.Column="0" FontFamily="Script MT Bold"/>
                    <ComboBox x:Name="CourseLanguageComboBox" Height="30" FontSize="14" Grid.Row="1" Grid.Column="0" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="German"/>
                        <ComboBoxItem Content="French"/>
                        <ComboBoxItem Content="Spanish"/>
                        <ComboBoxItem Content="Italian"/>
                        <ComboBoxItem Content="Russian"/>
                        <ComboBoxItem Content="Chinese"/>
                        <ComboBoxItem Content="Japanese"/>
                        <ComboBoxItem Content="Serbian"/>
                    </ComboBox>

                    <!-- Level -->
                    <Label Content="Level:" FontSize="16" Foreground="White" Grid.Row="0" Grid.Column="1" FontFamily="Script MT Bold"/>
                    <ComboBox x:Name="CourseLevelComboBox" Height="30" FontSize="14" Grid.Row="1" Grid.Column="1" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="A1 - Beginner"/>
                        <ComboBoxItem Content="A2 - Elementary"/>
                        <ComboBoxItem Content="B1 - Intermediate"/>
                        <ComboBoxItem Content="B2 - Upper Intermediate"/>
                        <ComboBoxItem Content="C1 - Advanced"/>
                        <ComboBoxItem Content="C2 - Proficient"/>
                    </ComboBox>

                    <!-- Duration in weeks -->
                    <Label Content="Duration (weeks):" FontSize="16" Foreground="White" Grid.Row="2" Grid.Column="0" FontFamily="Script MT Bold"/>
                    <TextBox x:Name="CourseDurationBox" Height="30" FontSize="14" Grid.Row="3" Grid.Column="0" VerticalContentAlignment="Center"
                     Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                    <!-- Days of week -->
                    <Label Content="Days of week:" FontSize="16" Foreground="White" Grid.Row="2" Grid.Column="1" FontFamily="Script MT Bold"/>
                    <TextBox x:Name="CourseDaysBox" Height="30" FontSize="14" Grid.Row="3" Grid.Column="1" VerticalContentAlignment="Center"
                     ToolTip="Comma separated, e.g., Monday, Wednesday" Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                    <!-- Start date -->
                    <Label Content="Start Date:" FontSize="16" Foreground="White" Grid.Row="4" Grid.Column="0" FontFamily="Script MT Bold"/>
                    <DatePicker x:Name="CourseStartDatePicker" Height="30" FontSize="14" Grid.Row="5" Grid.Column="0" VerticalContentAlignment="Center"
                        Validation.ErrorTemplate="{StaticResource ValidationTemplate}"/>

                    <!-- Online / Offline -->
                    <Label Content="Mode:" FontSize="16" Foreground="White" Grid.Row="4" Grid.Column="1" FontFamily="Script MT Bold"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="5" Grid.Column="1">
                        <RadioButton x:Name="OnlineRadioButton" Content="Online" FontFamily="Script MT Bold"/>
                        <RadioButton x:Name="OfflineRadioButton" Content="Offline" FontFamily="Script MT Bold"/>
                    </StackPanel>

                    <!-- Max students (if offline) -->
                    <Label Content="Max Students:" FontSize="16" Foreground="White" Grid.Row="6" Grid.Column="0" FontFamily="Script MT Bold"/>
                    <TextBox x:Name="CourseMaxStudentsBox" Height="30" FontSize="14" Grid.Row="7" Grid.Column="0" VerticalContentAlignment="Center"
                     Validation.ErrorTemplate="{StaticResource ValidationTemplate}" ToolTip="Only required for offline courses"/>

                    <!-- Buttons -->
                    <Button Style="{StaticResource FancyButtonStyle}" Content="Save" Height="50" Width="100" FontSize="16" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,20,0,0" Click="SaveCourse_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/LoginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                    <Button Style="{StaticResource FancyButtonStyle}" Content="Cancel" Height="50" Width="100" FontSize="16" Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,80,0,0" Click="CloseAddCoursePanel_Click">
                        <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/LoginButtonBackground.png"/>
                        </Button.Background>
                    </Button>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>

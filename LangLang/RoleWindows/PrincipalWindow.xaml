<Window x:Class="LangLang.RoleWindows.PrincipalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="PrincipalWindow" 
        Height="600" Width="900"
        Icon="/GUIResources/icon.ico">

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/GUIResources/loginBackground.jpg" Stretch="Fill"/>
        </Grid.Background>

        <!-- Main panel -->
        <Grid x:Name="MainPanel" Visibility="Visible">
            <Viewbox Stretch="Uniform">
                <Grid Width="800" Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Top bar -->
                        <RowDefinition Height="*"/>     <!-- Content -->
                        <RowDefinition Height="Auto"/>  <!-- Bottom buttons -->
                    </Grid.RowDefinitions>

                    <!-- Top bar -->
                    <Grid Grid.Row="0" Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Navigation buttons -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0">

                            <!-- Teachers Button -->
                            <Button x:Name="TeachersButton" Content="Teachers" Style="{StaticResource FancyButtonStyle}" FontSize="24" Width="140" Height="45" Click="TeachersButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                                <Button.ContextMenu>
                                    <ContextMenu x:Name="TeachersContextMenu" Placement="Bottom" PlacementTarget="{Binding RelativeSource={RelativeSource Self}}">
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>

                                        <MenuItem Header="Show all teachers" Click="ShowAllTeachers_Click"/>
                                        <MenuItem Header="Search teachers" Click="SearchTeachers_Click"/>
                                        <MenuItem Header="Sort teachers" Click="SortTeachers_Click"/>
                                        <MenuItem Header="Add teacher" Click="AddTeacher_Click"/>
                                        <MenuItem Header="Update teacher" Click="UpdateTeacher_Click"/>
                                        <MenuItem Header="Delete teacher" Click="DeleteTeacher_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Courses Button -->
                            <Button x:Name="CoursesButton" Content="Courses" Style="{StaticResource FancyButtonStyle}" FontSize="24" Width="140" Height="45" Click="CoursesButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                        <MenuItem Header="Smart assign professor" Click="SmartAssignProfessor_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Exams Button -->
                            <Button x:Name="ExamsButton" Content="Exams" Style="{StaticResource FancyButtonStyle}" FontSize="24" Width="140" Height="45" Click="ExamsButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                        <MenuItem Header="Smart assign examiner" Click="SmartAssignExaminer_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                            <!-- Reports Button -->
                            <Button x:Name="ReportsButton" Content="Reports" Style="{StaticResource FancyButtonStyle}" FontSize="24" Width="140" Height="45" Click="ReportsButton_Click">
                                <Button.Background>
                                    <ImageBrush ImageSource="/GUIResources/topBarButtonBackground.png"/>
                                </Button.Background>
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <ContextMenu.ItemContainerStyle>
                                            <Style TargetType="MenuItem">
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="Background" Value="Gold"/>
                                                <Setter Property="FontFamily" Value="Script MT Bold"/>
                                                <Setter Property="FontSize" Value="20"/>
                                            </Style>
                                        </ContextMenu.ItemContainerStyle>
                                        <MenuItem Header="Generate penalty report" Click="ReportPenalties_Click"/>
                                        <MenuItem Header="Generate course report" Click="ReportCourses_Click"/>
                                        <MenuItem Header="Generate exam report" Click="ReportExams_Click"/>
                                        <MenuItem Header="Generate language report" Click="ReportLanguages_Click"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Content: DataGrid for teachers -->
                    <Grid Grid.Row="1" Margin="0,20,0,0" Background="#80000000">
                        <DataGrid x:Name="TeachersDataGrid" 
                            AutoGenerateColumns="False" 
                              FontSize="14" 
                              Foreground="Black" 
                            Background="#50000000">

                            <!-- This Resources block styles the column headers -->
                            <DataGrid.Resources>
                                <Style TargetType="{x:Type DataGridColumnHeader}">
                                    <Setter Property="Background" Value="LightGoldenrodYellow"/>
                                    <Setter Property="Foreground" Value="Black"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*"/>
                                <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*"/>
                                <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding PhoneNumber}" Width="*"/>
                                <DataGridTextColumn Header="Date Added" Binding="{Binding DateOfRegistration}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Bottom buttons -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="Add Teacher" Style="{StaticResource FancyButtonStyle}" Width="150" Height="50" Margin="10,0" FontSize="18" Click="AddTeacher_Click">
                            <Button.Background>
                            <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                            </Button>
                        <Button Content="Update Teacher" Style="{StaticResource FancyButtonStyle}" Width="150" Height="50" Margin="10,0" FontSize="18" Click="UpdateTeacher_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                        <Button Content="Delete Teacher" Style="{StaticResource FancyButtonStyle}" Width="150" Height="50" Margin="10,0" FontSize="18" Click="DeleteTeacher_Click">
                            <Button.Background>
                                <ImageBrush ImageSource="/GUIResources/loginButtonBackground.png"/>
                            </Button.Background>
                        </Button>
                    </StackPanel>
                </Grid>
            </Viewbox>
        </Grid>
    </Grid>
</Window>
